rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'andreandersoncarvalhorocha1@gmail.com' ||
        (exists(/databases/$(database)/documents/userRoles/$(request.auth.token.email)) && 
         get(/databases/$(database)/documents/userRoles/$(request.auth.token.email)).data.role == 'ADMIN')
      );
    }

    function getUserRole() {
      return exists(/databases/$(database)/documents/userRoles/$(request.auth.token.email))
        ? get(/databases/$(database)/documents/userRoles/$(request.auth.token.email)).data.role
        : 'TECHNICIAN';
    }

    function getUserWarehouse() {
      return exists(/databases/$(database)/documents/userRoles/$(request.auth.token.email)) 
        ? get(/databases/$(database)/documents/userRoles/$(request.auth.token.email)).data.get('warehouse', null)
        : null;
    }

    function hasPermission(permission) {
      return isAdmin() || (
        isSignedIn() && 
        exists(/databases/$(database)/documents/rolePermissions/$(getUserRole())) &&
        get(/databases/$(database)/documents/rolePermissions/$(getUserRole())).data.get('permissions', {}).get(permission, false) == true
      );
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidRegistration(data) {
      return data.keys().hasAll(['plate', 'warehouse', 'reason', 'technician', 'dot', 'tireFogo', 'lifeCycle', 'removalDate', 'status', 'createdAt'])
        && data.plate is string && data.plate.size() <= 20
        && data.warehouse is string && data.warehouse.size() <= 60
        && (isAdmin() || getUserWarehouse() == null || data.warehouse == getUserWarehouse())
        && data.reason is string && data.reason.size() <= 100
        && data.technician is string && data.technician.size() <= 100
        && data.dot is string && data.dot.size() <= 20
        && data.tireFogo is string && data.tireFogo.size() <= 20
        && data.lifeCycle is string && data.lifeCycle.size() <= 20
        && data.removalDate is string && data.removalDate.size() <= 20
        && data.status in ['pending', 'confirmed']
        && (data.createdAt == request.time || data.createdAt is timestamp)
        && (!data.keys().contains('userEmail') || (data.userEmail is string && data.userEmail.size() <= 100));
    }

    match /registrations/{regId} {
      allow get: if isSignedIn() && (
        isAdmin() || (
          hasPermission('viewGeneralHistory') && 
          (getUserWarehouse() == null || resource.data.warehouse == getUserWarehouse())
        )
      );
      allow list: if isSignedIn() && (
        isAdmin() || (
          hasPermission('viewDashboard') && 
          (getUserWarehouse() == null || resource.data.warehouse == getUserWarehouse())
        )
      );
      allow create: if isSignedIn() && hasPermission('registerWithdrawal') && isValidRegistration(request.resource.data);
      allow update: if isSignedIn() && (
        isAdmin() || (
          hasPermission('confirmTechnicalWithdrawal') 
          && (getUserWarehouse() == null || resource.data.warehouse == getUserWarehouse())
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
          && request.resource.data.status == 'confirmed'
        )
      );
      allow delete: if isAdmin() || hasPermission('deleteRecords');
    }

    match /userRoles/{email} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.auth.token.email == email && request.resource.data.role == 'TECHNICIAN';
      allow update, delete: if isAdmin() || hasPermission('managePermissions');
    }

    match /rolePermissions/{role} {
      allow read: if isSignedIn();
      allow write: if isAdmin() || hasPermission('managePermissions');
    }

    match /settings/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin() || hasPermission('importData');
    }
  }
}
